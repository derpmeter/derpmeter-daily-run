{
  "name": "derpmeter-daily-run",
  "version": "1.0.0",
  "private": true,
  "description": "DerpMeter Daily Run: the same small chores every day for each coding agent model, judged like a DerpMeter vote. Not a benchmark.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "list": "node bin/lab-daily.mjs --list",
    "dry": "node --env-file-if-exists=.env bin/lab-daily.mjs",
    "daily": "node --env-file=.env bin/lab-daily.mjs --apply --publish",
    "install:launchd": "sh bin/install.sh"
  }
}
