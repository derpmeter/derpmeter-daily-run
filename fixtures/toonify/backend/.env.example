# Local development only. Copy to .env.local; never commit real credentials.
PROJECT_NAME=Toonify
API_V1_STR=/api/v1
DEBUG=True
BACKEND_CORS_ORIGINS=http://localhost:3000
# Required: generate a unique value, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_SERVER=localhost:5432
POSTGRES_USER=toonify
POSTGRES_PASSWORD=password
POSTGRES_DB=toonify_db
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=toonify-assets
MINIO_SECURE=False
STORAGE_TYPE=minio
STORAGE_HOST=http://localhost:9000/toonify-assets
# Required: your own Gemini API key, or configure Vertex AI with ADC instead.
GEMINI_API_KEY=
# Required settings fields; may be empty in direct API-key mode.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
