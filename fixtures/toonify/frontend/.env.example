# Local development only. Copy to .env.local; never commit real credentials.
INTERNAL_BACKEND_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_AUTH_MODE=hybrid
NEXT_PUBLIC_PAYMENTS_ENABLED=false
# Required: your own Clerk development instance keys.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
STORAGE_TYPE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=False
MINIO_BUCKET=toonify-assets
